{
  "name": "termify",
  "productName": "Termify",
  "version": "1.0.4",
  "description": "Termify: Türkçe, Termius benzeri SSH istemcisi (terminal, SFTP, port yönlendirme, anahtar yönetimi)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.muhammed61.termify",
    "productName": "Termify",
    "copyright": "Copyright © 2026 Muhammed61",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "!node_modules/cpu-features/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Termify-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Termify",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Termify-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Termify ${version}",
      "artifactName": "Termify-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Türkçe SSH istemcisi",
      "maintainer": "Muhammed61 <muhammed61@users.noreply.github.com>",
      "executableName": "termify",
      "artifactName": "Termify-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Termify",
          "Comment": "Türkçe SSH istemcisi",
          "Keywords": "ssh;sftp;terminal;"
        }
      }
    },
    "publish": {
      "provider": "github",
      "owner": "Muhammed61",
      "repo": "termify-releases"
    },
    "npmRebuild": false
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Muhammed61",
  "homepage": "https://github.com/Muhammed61/termify",
  "bugs": "https://github.com/Muhammed61/termify/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammed61/termify.git"
  }
}
